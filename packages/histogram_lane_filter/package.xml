<?xml version="1.0"?>
<package format="3">
  <name>histogram_lane_filter</name>
  <version>1.0.0</version>
  <description>Histogram lane filter of the lx-estimation Learning Experience (ROS 2): estimates the lane pose (d, phi) from the camera images and the wheel encoders.</description>
  <maintainer email="paull@mit.edu">Liam Paull</maintainer>
  <license>GPLv3</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>duckietown_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>lx_ros2_tools</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
